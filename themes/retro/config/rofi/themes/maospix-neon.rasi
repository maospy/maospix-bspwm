
/* MAOSPIX BSPWM - NEON */

* {
    bg:        #121025;
    bg-alt:    #292044;
    fg:        #EAE6FF;
    accent:    #B388FF;
    secondary: #42D9FF;
    muted:     #79718F;

    font: "JetBrains Mono 11";
}

window {
    location: center;
    anchor: center;
    width: 570px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    padding: 16px;
}

mainbox {
    background-color: @bg;
    children: [inputbar, listview];
    spacing: 14px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px;
    spacing: 10px;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @secondary;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Buscar aplicaciones...";
    placeholder-color: @muted;
}

listview {
    background-color: @bg;
    columns: 2;
    lines: 5;
    spacing: 7px;
    fixed-height: true;
    scrollbar: false;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 10px;
    spacing: 10px;
    border-radius: 9px;
}

element selected {
    background-color: @bg-alt;
}

element-icon {
    background-color: transparent;
    size: 26px;
}

element-text {
    background-color: transparent;
    text-color: @fg;
    vertical-align: 0.5;
}

element-text selected {
    text-color: @accent;
}
