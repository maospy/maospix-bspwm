{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  │  ",
    "color": {
      "keys": "#88C0D0",
      "title": "#ECEFF4",
      "separator": "#4C566A"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "format": "{##88C0D0}  M A O S P I X{#}   {##81A1C1}BSPWM EDITION{#}"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "{##4C566A}────────────────────────────────────────────{#}"
    },
    "title",
    {"type": "os", "key": "Sistema"},
    {"type": "kernel", "key": "Kernel"},
    {"type": "wm", "key": "Escritorio"},
    {"type": "terminal", "key": "Terminal"},
    "break",
    {"type": "cpu", "key": "Procesador"},
    {"type": "gpu", "key": "Gráficos"},
    {"type": "memory", "key": "Memoria"},
    {"type": "disk", "key": "Disco"},
    {"type": "uptime", "key": "Actividad"},
    {"type": "packages", "key": "Paquetes"},
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##88C0D0}●{#} {##81A1C1}●{#} {##5E81AC}●{#} {##A3BE8C}●{#}  {##D8DEE9}MAOSPIX PROJECT{#}"
    }
  ]
}
